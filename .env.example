# Copy this file to `.env` and fill in the values you want.
# `npm start` auto-loads .env; nothing is read if a value is omitted.

# ============================================================
# AI tools (Summarize, Translate, PDF → Markdown, Gemini OCR)
# ============================================================
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override the default Gemini model if you want.
# GEMINI_MODEL=gemini-3.8-flash

# ============================================================
# Email delivery (Send file via email tool)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="PDF Toolkit <you@example.com>"
# SMTP_SECURE=0

# ============================================================
# Cloud storage pickers (optional, in each tool's dropzone)
# ============================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_API_KEY=
# DROPBOX_APP_KEY=
